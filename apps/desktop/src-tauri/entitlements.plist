<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  打包签名的 entitlements。

  为什么必须有 com.apple.security.device.audio-input：Tauri 默认给可执行文件
  开启 hardened runtime（`codesign` 输出里的 flags=0x10002(adhoc,runtime)）。
  在 hardened runtime 下，tccd 只有在进程持有该 entitlement 时才允许弹出麦克风
  授权；缺失时它直接拒绝，连弹窗都不弹，应用也不会出现在「系统设置 → 隐私与
  安全性 → 麦克风」列表里。日志表现为：

    Prompting policy for hardened runtime; service: kTCCServiceMicrophone
    requires entitlement com.apple.security.device.audio-input but it is missing
    Policy disallows prompt for Sub:{dev.semios.desktop} ... denied

  因此这里只声明采集所需的最小权限，不添加 App Sandbox、AppleEvents 等当前
  能力边界之外的条目。辅助功能、输入监听、屏幕录制三项由 TCC 自行管理，不需要
  entitlement。
-->
<plist version="1.0">
<dict>
    <key>com.apple.security.device.audio-input</key>
    <true/>
</dict>
</plist>
