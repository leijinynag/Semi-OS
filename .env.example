# 复制为仓库根目录的 .env 后填写。真实密钥只供本地 Node Worker 使用，
# 不要提交到 Git，也不要放进 Vite 的 VITE_* 环境变量。
DASHSCOPE_API_KEY=

# 语音模型使用 DashScope AOQ WebSocket 协议，不使用文本模型的 OpenAI /
# Anthropic 兼容地址。拥有独立 Workspace 域名时可在这里替换。
SEMI_OS_DASHSCOPE_WEBSOCKET_URL=wss://maas.qianwenaiapi.com/api-ws/v1/inference
SEMI_OS_STT_MODEL=qwen-audio-3.1-asr-flash-streaming
# 当前默认使用 Fun-ASR；设置 qwen 可切回上面的 Qwen 模型。
# Fun 使用独立参数，下面的近场、语言及即时热词仅用于 Qwen。
SEMI_OS_STT_PROVIDER=fun
SEMI_OS_FUN_STT_MODEL=fun-asr-realtime
# Fun 独立定制热词入口，不使用 Qwen 的即时 vocabulary 参数。
# 留空表示未启用。当前网关的词表服务兼容性必须实测，失败不会静默忽略。
SEMI_OS_FUN_STT_VOCABULARY_ID=
SEMI_OS_STT_NEARFIELD=true
SEMI_OS_STT_LANGUAGES=zh,en
SEMI_OS_STT_HOTWORDS=Semi-OS,Pi,Codex,Claude Code,飞书
SEMI_OS_TTS_MODEL=cosyvoice-v3.5-plus
# PCM 首段到达即可播放；排查兼容问题时可设置 mp3（可能等待整句）。
SEMI_OS_TTS_FORMAT=pcm

# 必填。v3.5 不支持系统音色，请填写使用相同 target_model 创建且状态为 OK
# 的声音复刻/设计 voice_id。默认使用 Plus，创建音色时也必须使用
# target_model=cosyvoice-v3.5-plus；Plus 与 Flash 的 voice_id 不能混用。
SEMI_OS_TTS_VOICE=
