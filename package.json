{
  "name": "semi-os",
  "private": true,
  "version": "0.1.0",
  "description": "A local-first, voice-first desktop agent.",
  "packageManager": "pnpm@11.19.0",
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^22.15.0",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.6.2",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.46.3"
  },
  "scripts": {
    "generate:protocol": "node scripts/generate-protocol.mjs",
    "generate:check": "node scripts/generate-protocol.mjs --check",
    "dev": "pnpm --filter @semi-os/desktop dev",
    "build": "pnpm run build:js && pnpm run build:rust",
    "build:js": "pnpm -r run build",
    "build:rust": "cargo build --workspace",
    "test": "pnpm run test:js && pnpm run test:rust",
    "test:js": "node --test scripts/*.test.mjs && pnpm -r run test",
    "test:rust": "cargo test --workspace",
    "lint": "pnpm run lint:js && pnpm run lint:rust",
    "lint:js": "eslint .",
    "lint:rust": "cargo clippy --workspace --all-targets --all-features -- -D warnings",
    "format": "pnpm run format:js && pnpm run format:rust",
    "format:js": "prettier --write .",
    "format:rust": "cargo fmt --all",
    "format:check": "node scripts/check-format.mjs && cargo fmt --all -- --check",
    "typecheck": "pnpm -r run typecheck",
    "check:workspaces": "node scripts/check-workspaces.mjs",
    "check": "pnpm run check:workspaces && pnpm run generate:check && pnpm run format:check && pnpm run typecheck && pnpm run lint && cargo check --workspace && pnpm run test && pnpm run build && git diff --check"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
